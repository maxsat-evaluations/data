# === ANYTIME-UW 60 ===

let rawdata = open ~/results/ANYTIME-UW/60/ANYTIME-UW_60_rawdata.csv

let solvers = $rawdata | get solvername | uniq

mut data = gbd get "used_in='2026-anytime-unweighted'" | lines | wrap "hash"

for slv in $solvers {
  $data = $data | insert $slv {|row|
    let dat = $rawdata | where instance == $"($row.hash).wcnf" | where solvername == $slv | first
    if $dat.verified == 0 {
      "incorrect"
    } else {
      if $dat.answer in ["OPTIMUM FOUND" "SATISFIABLE"] {
        $dat.optval
      } else {
        "no-sol"
      }
    }
  }
}

$data | save results/2026-anytime-unweighted-60s.csv

let best = $rawdata
  | group-by instance --to-table
  | insert best {|row|
    let valid_vals = $row.items
      | where verified == 1
    if ($valid_vals | length) == 0 {
      "unknown"
    } else {
      $valid_vals | get "optval" | math min
    }
  }
  | select instance best

for row in $best {
  let hash = $row.instance | str replace '.wcnf' ''
  let best = $row.best
  if $best == "unknown" {
  } else {
    let gbd_val = gbd get $"hash like ($hash)" -r best_known_cost | cut -d ' ' -f2
    if $gbd_val == "unknown" {
      gbd set $"best_known_cost=($best)" $"hash like ($hash)"
    } else {
      if ($gbd_val | into int) > ($best | into int) {
        gbd set $"best_known_cost=($best)" $"hash like ($hash)"
      }
    }
  }
}

