#!/usr/bin/env -S nu --

# === EXACT-UW ===

let rawdata = open ~/results/EXACT-UW/3600/EXACT-UW_rawdata.csv

let solvers = $rawdata | get solvername | uniq

mut data = gbd get "used_in='2026-exact-unweighted'" | lines | wrap "hash"

for slv in $solvers {
  $data = $data | insert $slv {|row|
    let dat = $rawdata | where instance == $"($row.hash).wcnf" | where solvername == $slv | first
    if $dat.answer == "OPTIMUM FOUND" {
      if $dat.verified == 0 {
        "incorrect"
      } else {
        $dat | get "cpu.time"
      }
    } else {
      if $dat.timeout == "true" {
        "timeout"
      } else {
        if $dat.memout == "true" {
          "memout"
        } else {
          "unknown"
        }
      }
    }
  }
}

$data | save results/2026-exact-unweighted.csv

let optvals = $rawdata
  | group-by instance --to-table
  | insert optval {|row|
    let valid_vals = $row.items
      | where verified == 1
      | where answer == "OPTIMUM FOUND"
    if ($valid_vals | length) == 0 {
      "unknown"
    } else {
      $valid_vals | get "optval" | math min
    }
  }
  | select instance optval

for row in $optvals {
  let hash = $row.instance | str replace '.wcnf' ''
  let optval = $row.optval
  if $optval == NA or $optval == "unknown" {
  } else {
    let gbd_val = gbd get $"hash like ($hash)" -r optimal_cost | cut -d ' ' -f2
    if $gbd_val == "unknown" {
      gbd set $"optimal_cost=($optval)" $"hash like ($hash)"
      gbd set $"best_known_cost=($optval)" $"hash like ($hash)"
    }
  }
}

