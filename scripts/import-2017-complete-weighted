#!/usr/bin/env -S nu --

use std/assert

let filenames = gbd get --header -d ',' "used_in='2017-complete-weighted'" -g local -r hash
  | from csv
  | where local =~ "/mnt/tank/mse-benchmarks/ms_evals/MS17/mse17-complete-weighted-benchmarks/"

let data = http get https://maxsat-evaluations.github.io/2017/results/complete/weighted/table-all.html
  | query web --as-table []
  | insert hash {|row|
    # Escape '+' symbol
    let bench = $row.Benchmark
      | str replace "+" "\\+"
      | str replace --regex --multiline "^[\\w-]+/" ""
    let matches = $filenames | where local =~ $bench
    assert (($matches | length) == 1) $"no matches for ($row.Benchmark) [($bench)]: ($matches | length)"
    $matches | first | get hash
  }
  | insert filename {|row|
    let bench = $row.Benchmark
      | str replace "+" "\\+"
      | str replace --regex --multiline "^[\\w-]+/" ""
    let matches = $filenames | where hash == $row.hash | where local =~ $bench
    assert (($matches | length) == 1) $"no matches for ($row.Benchmark) [($bench)]: ($matches | length)"
    $matches | first | get local | str replace "/mnt/tank/mse-benchmarks/ms_evals/MS17/mse17-complete-weighted-benchmarks/" ""
  }

let solvers = $data
  | columns
  | where $it not-in [Benchmark hash filename]

mut $runtimes = $data | select hash filename
mut $costs = $data | select hash

for slv in $solvers {
  let slvdata = $data
    | each --flatten {|row| $row | get $slv | parse "{time} ({cost})"}
  $runtimes = $runtimes
    | merge ($slvdata | select time | into float time | rename --column { time: $slv })
  $costs = $costs
    | merge ($slvdata | select cost | rename --column { cost: $slv })
}

$costs = $costs
  | where {|row| ($row | reject hash | values | where $it != "-" | length) > 0}
  | each --flatten {|row|
    let values = $row | reject hash | values | where $it != "-" | into int
    let min = $values | math min
    let max = $values | math max
    assert ($min == $max)
    { hash: $row.hash, cost: $max }
  }

let db_costs = gbd get --header -d ',' "used_in='2017-complete-weighted'" -r optimal_cost best_known_cost
  | from csv

for row in $costs {
  let db_cost = $db_costs | where hash == $row.hash | get optimal_cost
  assert (($db_cost | length) == 1) $"none or multiple cost values for hash ($row.hash)"
  let db_cost = $db_cost | first
  assert (($db_cost == "unknown") or (($db_cost | into int) == $row.cost)) $"optimal cost value does not match for ($row.hash)"
  if $db_cost == "unknown" {
    gbd set $"optimal_cost=($row.cost)" --hashes $row.hash
    gbd set $"best_known_cost=($row.cost)" --hashes $row.hash
  } else {
    assert (($db_costs | where hash == $row.hash | get best_known_cost | first | into int) == $row.cost)
  }
}

$runtimes
  | select hash filename ...$solvers
  | save results/2017-complete-weighted.csv
