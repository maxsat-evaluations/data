#!/usr/bin/env bash

# This script unpacks the zip archive of an old MSE track, normalizes all
# instances, copies them to <outdir>/track and imports them into the database
#
# Usage: add-old-benchmark-set <track> <archive> <outdir>

set -euo pipefail

TRACK=$1
shift
ARCHIVE=$1
shift
OUT_DIR=$1
shift

EXDIR="$(dirname "$ARCHIVE")/unpacked"
mkdir "$EXDIR"

unzip -d "$EXDIR" "$ARCHIVE"

IN_DIR="$EXDIR"
if [ $(ls -1 "$IN_DIR" | wc -l) -eq 1 ]; then
  if [ -d "$IN_DIR/$(ls -1 "$IN_DIR")" ]; then
    IN_DIR="$IN_DIR/$(ls -1 "$IN_DIR")"
  fi
fi

>&2 echo "Importing from '$IN_DIR'"

mkdir -p "$OUT_DIR/$TRACK"

OUT_DIR="$(realpath -e "$OUT_DIR/$TRACK")"

>&2 echo "Adding $(find "$IN_DIR" \( -name '*.wcnf' -or -name '*.wcnf.gz' -or -name '*.wcnf.xz' \) | wc -l) benchmark instances"

FILENAMES="$OUT_DIR/wcnf_filenames.csv"
echo "hash,filename" >> "$FILENAMES"

# Dummy database to not get problems when real DBs are locked
touch /tmp/dummy.csv

find "$IN_DIR" -name '*.wcnf' \
  -exec bash -c 'set -euo pipefail
    inst="$0"
    filename="${inst#$(realpath -e "$2")/}"
    mkdir -p "$1/$(dirname "$filename")"
    outfile="$1/$(dirname "$filename")/$(basename "$filename").xz"
    std_wcnf "$inst" | xz > "$outfile"
    chmod 444 "$outfile"
    echo "$(gbd -d /tmp/dummy.csv hash "$outfile"),$filename"
  ' {} "$OUT_DIR" "$IN_DIR" \; >> "$FILENAMES"
find "$IN_DIR" -name '*.wcnf.gz' \
  -exec bash -c 'set -euo pipefail
    inst="$0"
    filename="${inst#$(realpath -e "$2")/}"
    mkdir -p "$1/$(dirname "$filename")"
    outfile="$1/$(dirname "$filename")/$(basename "$filename" ".gz").xz"
    std_wcnf "$inst" | xz > "$outfile"
    chmod 444 "$outfile"
    echo "$(gbd -d /tmp/dummy.csv hash "$outfile"),$filename"
  ' {} "$OUT_DIR" "$IN_DIR" \; >> "$FILENAMES"
find "$IN_DIR" -name '*.wcnf.xz' \
  -exec bash -c 'set -euo pipefail
    inst="$0"
    filename="${inst#$(realpath -e "$2")/}"
    mkdir -p "$1/$(dirname "$filename")"
    outfile="$1/$(dirname "$filename")/$(basename "$filename")"
    xz -dc "$inst" | std_wcnf | xz > "$outfile"
    chmod 444 "$outfile"
    echo "$(gbd -d /tmp/dummy.csv hash "$outfile"),$filename"
  ' {} "$OUT_DIR" "$IN_DIR" \; >> "$FILENAMES"

rm -rf "$EXDIR"

gbd init --target wcnf_local -j8 local "$OUT_DIR"

gbd set "used_in=$TRACK" "local like $OUT_DIR/%"
