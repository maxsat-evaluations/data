#!/usr/bin/env -S nu --

use std/assert

# === 60s ===

let data = http get https://maxsat-evaluations.github.io/2021/results/incomplete/weighted-60s/table-all.html
  | query web --as-table []
  | insert filename {|row|
    let base = if $row.Instance =~ " \\(" {
      let rec = $row.Instance | parse --regex "(?<short>.+) \\([^\\)]+\\)?"
      $rec.short | first
    } else {
      $row.Instance
    }
    $"($base).gz"
  }
  | into int "BestSol"

let duplicates = $data
  | where Instance =~ " \\("
  | each --flatten {|row|
    let rec = $row.Instance | parse --regex "(?<short>.+) \\((?<longer>[^\\)]+)\\)?"
    if ($rec.longer | first) =~ "\\.gz$" {
      { short: $"($rec.short | first).gz", longer: ($rec.longer | first) }
    } else if ($rec.longer | first) =~ "\\.gz:p$" {
      { short: $"($rec.short | first).gz", longer: ($rec.longer | first | str replace ":p" "") }
    } else {
      { short: $"($rec.short | first).gz", longer: $"($rec.longer | first).gz" }
    }
  }

let solvers = $data
  | columns
  | where $it not-in ["Instance" "BestSol" "filename"]

mut $scores = $data | select filename
mut $costs = $data | select filename "BestSol"

for slv in $solvers {
  let slvdata = $data
    | each --flatten {|row|
      let rec = $row | get $slv | parse "{score} ({cost})"
      for cost in $rec.cost {
        assert (($cost == "-") or (($cost | into int) >= ($row | get "BestSol")))
      }
      $rec
    }
  $scores = $scores
    | merge ($slvdata | select score | into float score | rename --column { score: $slv })
  $costs = $costs
    | merge ($slvdata | select cost | rename --column { cost: $slv })
}

let filenames = open /mnt/tank/mse-benchmarks/tracks/2021-incomplete-weighted/wcnf_filenames.csv
  | insert shortened {|row| $row.filename | path basename}
  | update shortened {|row|
    if $row.shortened in ($duplicates | get short) {
      let match = $duplicates
        | where {|it| $row.filename =~ $"($it.longer)$"}
      assert (($match | length) == 1) $"($row.filename): ($match)"
      $match | first | get short
    } else {
      $row.shortened
    }
  }

let db_costs = gbd get --header -d ',' "used_in='2021-incomplete-weighted'" -r optimal_cost best_known_cost
  | from csv

for row in ($filenames | join --left $costs shortened filename) {
  if ($row | get "BestSol" | is-empty) {
    continue
  }
  let db_cost = $db_costs | where hash == $row.hash | get optimal_cost
  assert (($db_cost | length) == 1) $"none or multiple cost values for hash ($row.hash)"
  let db_cost = $db_cost | first
  assert (($db_cost == "unknown") or (($db_cost | into int) <= ($row | get "BestSol"))) $"optimal cost value does not match for ($row.hash)"
  let db_best_known = $db_costs | where hash == $row.hash | get best_known_cost | first
  if ($db_best_known == "unknown") or (($db_best_known | into int) > ($row | get "BestSol")) {
    gbd set $"best_known_cost=($row | get 'BestSol')" --hashes $row.hash
  }
}

$filenames
  | join --left ($scores | rename --column ($solvers | each {|slv| { $slv: $"($slv)_score" } } | into record)) shortened filename
  | join --left ($costs | rename --column ($solvers | each {|slv| { $slv: $"($slv)_cost" } } | into record)) shortened filename
  | select hash filename ...($solvers | each {|slv| [$"($slv)_score" $"($slv)_cost"]} | flatten)
  | save results/wcnf_2021-incomplete-weighted-60s.csv

# === 300s ===

let data = http get https://maxsat-evaluations.github.io/2021/results/incomplete/weighted-300s/table-all.html
  | query web --as-table []
  | insert filename {|row|
    let base = if $row.Instance =~ " \\(" {
      let rec = $row.Instance | parse --regex "(?<short>.+) \\([^\\)]+\\)?"
      $rec.short | first
    } else {
      $row.Instance
    }
    $"($base).gz"
  }
  | into int "Best Sol"

let solvers = $data
  | columns
  | where $it not-in ["Instance" "Best Sol" "filename"]

mut $scores = $data | select filename
mut $costs = $data | select filename "Best Sol"

for slv in $solvers {
  let slvdata = $data
    | each --flatten {|row|
      let rec = $row | get $slv | parse "{score} ({cost})"
      for cost in $rec.cost {
        assert (($cost == "-") or (($cost | into int) >= ($row | get "Best Sol")))
      }
      $rec
    }
  $scores = $scores
    | merge ($slvdata | select score | into float score | rename --column { score: $slv })
  $costs = $costs
    | merge ($slvdata | select cost | rename --column { cost: $slv })
}

let db_costs = gbd get --header -d ',' "used_in='2021-incomplete-weighted'" -r optimal_cost best_known_cost
  | from csv

for row in ($filenames | join --left $costs shortened filename) {
  if ($row | get "Best Sol" | is-empty) {
    continue
  }
  let db_cost = $db_costs | where hash == $row.hash | get optimal_cost
  assert (($db_cost | length) == 1) $"none or multiple cost values for hash ($row.hash)"
  let db_cost = $db_cost | first
  assert (($db_cost == "unknown") or (($db_cost | into int) <= ($row | get "Best Sol"))) $"optimal cost value does not match for ($row.hash)"
  let db_best_known = $db_costs | where hash == $row.hash | get best_known_cost | first
  if ($db_best_known == "unknown") or (($db_best_known | into int) > ($row | get "Best Sol")) {
    gbd set $"best_known_cost=($row | get 'Best Sol')" --hashes $row.hash
  }
}

$filenames
  | join --left ($scores | rename --column ($solvers | each {|slv| { $slv: $"($slv)_score" } } | into record)) shortened filename
  | join --left ($costs | rename --column ($solvers | each {|slv| { $slv: $"($slv)_cost" } } | into record)) shortened filename
  | select hash filename ...($solvers | each {|slv| [$"($slv)_score" $"($slv)_cost"]} | flatten)
  | save results/wcnf_2021-incomplete-weighted-300s.csv
